{
  "name": "lambda-prune",
  "description": "Delete old AWS Lambda function versions to reclaim storage and keep deployments tidy.",
  "homepage": "https://github.com/Kikobeats/lambda-prune",
  "version": "1.1.9",
  "main": "index.js",
  "bin": {
    "lambda-prune": "bin/index.js"
  },
  "author": {
    "email": "josefrancisco.verdu@gmail.com",
    "name": "Kiko Beats",
    "url": "https://kikobeats.com"
  },
  "contributors": [
    {
      "name": "Andrew Peebles",
      "email": "peebles@viblio.com"
    },
    {
      "name": "peebles",
      "email": "aqpeeb@gmail.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kikobeats/lambda-prune.git"
  },
  "bugs": {
    "url": "https://github.com/Kikobeats/lambda-prune/issues"
  },
  "keywords": [
    "aws",
    "cleanup",
    "cli",
    "delete",
    "functions",
    "lambda",
    "prune",
    "remove",
    "serverless",
    "versions"
  ],
  "dependencies": {
    "acho": "latest",
    "acho-skin-cli": "latest",
    "aws-sdk": "latest",
    "beauty-error": "latest",
    "meow": "9",
    "update-notifier": "latest"
  },
  "devDependencies": {
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "ci-publish": "latest",
    "finepack": "latest",
    "git-authors-cli": "latest",
    "github-generate-release": "latest",
    "nano-staged": "latest",
    "simple-git-hooks": "latest",
    "standard": "latest",
    "standard-markdown": "latest",
    "standard-version": "latest"
  },
  "engines": {
    "node": ">= 8"
  },
  "files": [
    "bin"
  ],
  "scripts": {
    "clean": "rm -rf node_modules",
    "contributors": "(npx git-authors-cli && npx finepack && git add package.json && git commit -m 'build: contributors' --no-verify) || true",
    "lint": "standard-markdown README.md && standard",
    "postrelease": "npm run release:tags && npm run release:github && ci-publish",
    "prerelease": "npm run contributors",
    "pretest": "npm run lint",
    "release": "standard-version -a",
    "release:github": "github-generate-release",
    "release:tags": "git push --follow-tags origin HEAD:master",
    "test": "exit 0"
  },
  "preferGlobal": true,
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-max-line-length": [
        0
      ]
    }
  },
  "nano-staged": {
    "*.js": [
      "git add",
      "prettier-standard"
    ],
    "*.md": [
      "git add",
      "standard-markdown"
    ],
    "package.json": [
      "finepack",
      "git add"
    ]
  },
  "simple-git-hooks": {
    "commit-msg": "npx commitlint --edit",
    "pre-commit": "npx nano-staged"
  }
}
